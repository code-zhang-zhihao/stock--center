APP_NAME=stock-center
APP_ENV=local
LOG_LEVEL=INFO
CONFIG_MASTER_KEY=
CONFIG_CACHE_TTL_SECONDS=60
CORS_ALLOW_ORIGINS=http://127.0.0.1:8080,http://localhost:8080
MARKET_DATA_NO_PROXY_DOMAINS=eastmoney.com,.eastmoney.com,10jqka.com.cn,.10jqka.com.cn,iwencai.com,.iwencai.com,sina.com.cn,.sina.com.cn,tdx.com.cn,.tdx.com.cn

# Example:
# postgresql+asyncpg://stock_center:stock_center@127.0.0.1:5432/stock_center
DATABASE_URL=
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_POOL_TIMEOUT_SECONDS=30
DATABASE_POOL_RECYCLE_SECONDS=1800
DATABASE_ECHO_POOL=false
